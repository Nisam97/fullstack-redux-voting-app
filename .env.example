# VoteSphere Environment Configuration Template
# Copy this file to .env and customize values for local development / testing.
# DO NOT commit real secrets or credentials to source control.

PORT=8090
MONGODB_URI=mongodb://localhost:27017/votesphere_dev
# Comma separated list of browser origins allowed to call the API with credentials.
# Use * only in development to disable origin checking.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to true only when the server sits behind a reverse proxy you control.
# Then the first x-forwarded-for entry keys the login throttle. Without it the
# socket address is used, so clients cannot spoof their way past throttling.
TRUST_PROXY=false
JWT_SECRET=change_this_to_a_secure_random_secret_in_production
JWT_EXPIRES_IN=24h
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@votesphere.local
ADMIN_PASSWORD=adminPassword123!

# ---------------------------------------------------------------------------
# CORS / Cookie (Phase 6+)
# ---------------------------------------------------------------------------
# The exact browser origin that the server allows with credentials: true.
CLIENT_ORIGIN=http://localhost:5173
# Set to true in production (HTTPS only). Leave false for local HTTP development.
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Voter JWT (Phase 6+)
# ---------------------------------------------------------------------------
# Secret used to sign the vs_voter httpOnly cookie.
VOTER_JWT_SECRET=change_this_to_another_secure_random_secret
# How long the voter session cookie lives (days).
VOTER_SESSION_DAYS=7

# ---------------------------------------------------------------------------
# OTP email (Phase 6+)
# ---------------------------------------------------------------------------
# If SMTP_HOST is left empty the server logs the OTP to the console instead
# of sending email, which is safe for local development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@votesphere.local
# How long a one-time password is valid (minutes).
OTP_TTL_MINUTES=10

# ---------------------------------------------------------------------------
# Timers (Authoritative Backend)
# ---------------------------------------------------------------------------
# Default duration for pairwise voting rounds in seconds (allowed range: 5-300).
VOTE_TIMER_DURATION=30
# Duration for the results reveal window in seconds before transitioning.
ROUND_REVEAL_DURATION=10

# ---------------------------------------------------------------------------
# Frontend Client (Optional)
# ---------------------------------------------------------------------------
# Target URL for backend WebSocket and REST communication from the browser.
VITE_SERVER_URL=http://localhost:8090

